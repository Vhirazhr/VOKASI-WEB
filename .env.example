# Legacy frontend configuration: the current UI still uses these until the native API cutover is complete.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Native self-hosted PostgreSQL backend (server-only; never prefix these with NEXT_PUBLIC_).
# Use the exact host/port shown by cPanel. URL-encode special characters in the password.
DATABASE_URL=postgresql://DB_USER:URL_ENCODED_PASSWORD@DB_HOST:DB_PORT/DB_NAME
# Use "require" for remote PostgreSQL with TLS; "disable" only for documented local/non-TLS DB.
DATABASE_SSL=disable
DATABASE_POOL_MAX=5
# Replace with a cryptographically random secret of at least 32 bytes. Never commit the real value.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# One-time Super Admin bootstrap only; inject in a protected terminal/environment and remove afterward.
# INITIAL_SUPER_ADMIN_USERNAME=
# INITIAL_SUPER_ADMIN_PASSWORD=
# INITIAL_SUPER_ADMIN_DISPLAY_NAME=
# ALLOW_SUPER_ADMIN_BOOTSTRAP=yes

# Private file storage root. Use an absolute writable directory outside public_html/web root.
# Example only: replace CPANEL_USER with the account's actual home directory.
STORAGE_ROOT=/home/CPANEL_USER/vokasi-private-storage

# Allowed origins for embedding VOKASI in a trusted school website. Leave blank if unused.
EMBED_ALLOWED_ORIGINS=
