# Ambil dari Supabase Project Settings > API Keys (PROJECT YANG SAMA dengan VOKASI Android)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Daftar ORIGIN yang boleh menampilkan web sebagai iframe, dipisah spasi.
# Kosong = hanya situs dengan origin yang sama.
EMBED_ALLOWED_ORIGINS=
